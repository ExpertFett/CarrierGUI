# Bundled Python interpreter (build artifact — fetched at release time, ~22 MB)
Patcher/python/

# Built release folders + zips
/dist/
*.zip

# Mission files + patcher backups (never belong in the repo)
*.miz
*.miz.bak
*.bak

# Python caches
__pycache__/
*.pyc

# Local "known-good" rollback copies (kept off-repo on purpose; the
# canonical fallbacks are git tag v0.9-stable and the GitHub release zip).
known-good-*/

# Editor / OS cruft
.vscode/
.idea/
desktop.ini
Thumbs.db
.DS_Store
*~

# Machine-local agent/relay config (real endpoints + tokens; .example.json are the templates)
*.local.json

# Installer / patcher transcripts
LSO/*-log.txt
LSO/*-install-log.txt
LSO/*-uninstall-log.txt

# Stray pasted screenshots
LSO/image-*.png
