    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
    ["states"] = { ["released"] = { [1] = {
        ["bkg"] = {
            ["center_bottom"]="0x0a0e12ee", ["center_center"]="0x0a0e12ee", ["center_top"]="0x0a0e12ee",
            ["left_bottom"]="0x0a0e12ee",   ["left_center"]="0x0a0e12ee",   ["left_top"]="0x0a0e12ee",
            ["right_bottom"]="0x0a0e12ee",  ["right_center"]="0x0a0e12ee",  ["right_top"]="0x0a0e12ee",
        },
        ["text"] = { ["color"]="0xffffffff", ["font"]="DejaVuLGCSansCondensed-Bold.ttf", ["lineHeight"]=S(14) },
    } } },
}
for i = 1, 16 do
