-- ============================================================= DECKBOSS TAB ==
-- v1.3-beta21: rotated so BOW = top, STERN = bottom, PORT = left, STBD = right
-- (standard top-down view).  The deck silhouette is painted with box-drawing
-- character widgets at port/stbd/bow/stern edges — dxgui has no line/rect
-- primitives so each character is its own Static widget.  Zone labels sit
-- inside the silhouette; modex slot pool gets repositioned by the hook from
-- carriergui_deck.txt every poll.

c.lblDbHdr      = lbl("DECK VIEW  ·  BOW = top  ·  PORT = left",  PAD, 30, W - PAD*2, LabelSkin, 18)

-- ── deck silhouette — HORIZONTAL: BOW = right, PORT = top ────────────────
-- Deck plate x=60..480 (420 long), y=120..240 (120 wide).
c.dbDeck    = solidW( 60, 120, 420, 120, DECK_FILL_SKIN, 1)
-- angled landing-area strip (rises to port/top toward the bow)
do
    local strip = solidW( 75, 161, 270,  48, DECK_STRP_SKIN, 2)
    strip.params.angle = -10
    strip.params.pivotPoint = { ["x"] = 135, ["y"] = 24 }
    c.dbStrip = strip
end
-- deck edge lines
