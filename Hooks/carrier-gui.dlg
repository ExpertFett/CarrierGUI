-- CarrierGUI dialog layout  (v1.3-beta5 — 5-tab skeleton)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.
--
-- v1.3 layout: 5 tabs across the top.
--   CARRIER   — F10 menu controls (lights, beacons, wind) — UNCHANGED in beta1
--   MARSHALL  — NEW. CCZ 60nm radar + radio readout (placeholder in beta1)
--   TOWER     — RENAMED from old MARSHALL. CASE / Charlie / stack broadcasts
--   LSO       — PLAT NVG + camera controls. UNCHANGED in beta1 (overhead
--               pattern + drop-of-Wire/Deck/Zoom arrives in beta4)
--   DECKBOSS  — NEW. Top-down deck view (placeholder in beta1)
--
-- Panel widened from 380→540 to make room for the radars in later betas.

local W = 540       -- window width  (was 380 in v1.2)
local H = 800       -- window height (was 640 in v1.2-beta5; need room for rosters)
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = size or 14,
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = BTN_H, ["w"] = w or BTN_W, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = h or 18, ["w"] = w or 200, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]  = { ["h"] = H, ["w"] = W, ["x"] = 200, ["y"] = 100 },
        ["enabled"] = true,
        ["text"]    = "Carrier Control",
        ["tooltip"] = "",
        ["visible"] = false,            -- hook flips to true after creation
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- ---------------------------------------------------------------- TAB BAR ---
-- v1.3-beta5: 5 tabs across the top in a wider (540 px) window.
-- Each tab = 100 wide, 6 px gap. Total span: 5*100 + 4*6 = 524 < 540-PAD*2.
c.btnTabCarrier  = btn("CARRIER",  PAD + (100+6)*0, 4, 100)
c.btnTabMarshall = btn("MARSHALL", PAD + (100+6)*1, 4, 100)
c.btnTabTower    = btn("TOWER",    PAD + (100+6)*2, 4, 100)
c.btnTabLso      = btn("LSO",      PAD + (100+6)*3, 4, 100)
c.btnTabDeckboss = btn("DECKBOSS", PAD + (100+6)*4, 4, 100)

-- =============================================================== CARRIER TAB ==
local y = 40
c.lblLights         = lbl("LIGHTS", PAD, y)
y = y + 22
c.btnLightsOff      = btn("Off",      PAD + (BTN_W+PAD)*0, y)
c.btnLightsAuto     = btn("Auto",     PAD + (BTN_W+PAD)*1, y)
c.btnLightsNav      = btn("Nav",      PAD + (BTN_W+PAD)*2, y)
c.btnLightsLaunch   = btn("Launch",   PAD + (BTN_W+PAD)*3, y)
y = y + BTN_H + PAD
c.btnLightsRecovery = btn("Recovery", PAD, y, BTN_W*2 + PAD)

y = y + BTN_H + PAD*2
c.lblTacan          = lbl("TACAN", PAD, y)
y = y + 22
c.btnTacanOn        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnTacanOff       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblIcls           = lbl("ICLS", PAD, y)
y = y + 22
c.btnIclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnIclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblLink4          = lbl("LINK 4", PAD, y)
y = y + 22
c.btnLink4On        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnLink4Off       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblAcls           = lbl("ACLS", PAD, y)
y = y + 22
c.btnAclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnAclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblWind           = lbl("TURN INTO WIND", PAD, y, 250)
y = y + 22
local wb = 48
c.btnWindStop = btn("Stop", PAD + (wb+4)*0, y, wb)
c.btnWind30m  = btn("30m",  PAD + (wb+4)*1, y, wb)
c.btnWind60m  = btn("60m",  PAD + (wb+4)*2, y, wb)
c.btnWind90m  = btn("90m",  PAD + (wb+4)*3, y, wb)
c.btnWind2h   = btn("2h",   PAD + (wb+4)*4, y, wb)
c.btnWind4h   = btn("4h",   PAD + (wb+4)*5, y, wb)
c.btnWind8h   = btn("8h",   PAD + (wb+4)*6, y, wb)

-- ================================================================= TOWER TAB ==
-- v1.3: full content.
--   Top half = three roster sections (STACK / CHARLIE'D / COMMENCING) fed by
--   the bridge's carriergui_stack.txt file.  Each section has a header + a
--   column-header row + a pool of N row widgets the hook populates.
--   Bottom half = existing broadcasts (CASE selector + stack/Charlie timers).

-- --- STACK roster (HOLD aircraft, sorted alt-desc) ----------------------------
c.lblTwrStackHdr  = lbl("STACK  ·  holding",                            PAD,  30, W - PAD*2, LabelSkin, 18)
c.lblTwrStackCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",  PAD,  50, W - PAD*2, CapSkin,   16)
for i = 1, 8 do
    c["rowTwrStack" .. i] = lbl("", PAD, 68 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- CHARLIE'D roster (cleared to commence) ----------------------------------
c.lblTwrCharlieHdr  = lbl("CHARLIE'D  ·  cleared to commence",            PAD, 200, W - PAD*2, LabelSkin, 18)
c.lblTwrCharlieCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",  PAD, 220, W - PAD*2, CapSkin,   16)
for i = 1, 5 do
    c["rowTwrCharlie" .. i] = lbl("", PAD, 238 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- COMMENCING roster (past commence point) ---------------------------------
c.lblTwrCommHdr  = lbl("COMMENCING  ·  past commence point",              PAD, 325, W - PAD*2, LabelSkin, 18)
c.lblTwrCommCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",     PAD, 345, W - PAD*2, CapSkin,   16)
for i = 1, 5 do
    c["rowTwrComm" .. i] = lbl("", PAD, 363 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- Existing broadcast controls move down -----------------------------------
-- Widget names below keep their original "Mar*" prefix so BUTTON_FLAGS and the
-- broadcast wiring stay untouched.  The y-cursor `my` just starts lower now.
local my = 450
c.lblMarCase = lbl("RECOVERY CASE", PAD, my)
my = my + 22
c.btnCase1 = btn("CASE I",   PAD + (114+PAD)*0, my, 114)
c.btnCase2 = btn("CASE II",  PAD + (114+PAD)*1, my, 114)
c.btnCase3 = btn("CASE III", PAD + (114+PAD)*2 - 116, my + 0, 114)
-- third button on next position; keep 3 across if width allows, else wrap
c.btnCase3.params.bounds.x = PAD + (114+PAD)*2
my = my + BTN_H + PAD*2

c.lblMarStack = lbl("MARSHAL STACK", PAD, my)
my = my + 22
c.lblFlightsCap = lbl("Flights:", PAD, my + 4, 70, CapSkin)
c.btnFlightsDown = btn("-", PAD + 76,  my, 40)
c.lblFlightsVal  = lbl("1", PAD + 122, my + 4, 36, ValueSkin)
c.btnFlightsUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnMarshalBroadcast = btn("Broadcast Marshal Stack", PAD, my, 250)

my = my + BTN_H + PAD*2
c.lblMarCharlie = lbl("CHARLIE / PUSH", PAD, my)
my = my + 22
c.lblCharlieCap = lbl("Minutes:", PAD, my + 4, 70, CapSkin)
c.btnCharlieDown = btn("-", PAD + 76,  my, 40)
c.lblCharlieVal  = lbl("15", PAD + 122, my + 4, 36, ValueSkin)
c.btnCharlieUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnCharlieBroadcast = btn("Broadcast Charlie", PAD, my, 250)

-- ============================================================== MARSHALL TAB ==
-- v1.3: 60nm CCZ tracker.  Bridge writes carriergui_ccz.txt every poll with
-- one line per friendly air in the zone; hook fills the row pool below.
local SubSkin    = mkLabelSkin("0xccccccff", 16)
local RowSkin    = mkLabelSkin("0xe0e0e0ff", 14)
local RowSkinMon = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xe0e0e0ff",
                    ["font"]       = "DejaVuLGCSansMono.ttf",
                    ["lineHeight"] = 14,
                },
            },
        },
    },
}

c.lblMarshallHdr   = lbl("CCZ TRACKER  ·  60 nm",                    PAD,  30, W - PAD*2, LabelSkin, 20)
c.lblMarshallCols  = lbl("  MODEX   BRG   RNG    ALT    IAS",         PAD,  54, W - PAD*2, CapSkin,   16)
-- Row pool: 12 inbound aircraft max.  Hook fills name and clears unused rows.
for i = 1, 12 do
    c["rowCcz" .. i] = lbl("", PAD, 74 + (i-1)*16, W - PAD*2, RowSkinMon, 16)
end

-- Radio readout (altimeter, BRC, case, per-modex assignments)
c.lblMarRadioHdr   = lbl("RADIO READOUT",                            PAD, 282, W - PAD*2, LabelSkin, 20)
c.lblMarRadioBase  = lbl("ALT --.--   BRC ---°   CASE -",            PAD, 306, W - PAD*2, ValueSkin, 20)
c.lblMarRadioCols  = lbl("  MODEX   BRA          ALT     ASSIGN  EAT", PAD, 332, W - PAD*2, CapSkin, 16)
for i = 1, 12 do
    c["rowMarCall" .. i] = lbl("", PAD, 352 + (i-1)*16, W - PAD*2, RowSkinMon, 16)
end
c.lblMarStatus     = lbl("(waiting for inbound traffic...)",           PAD, 552, W - PAD*2, CapSkin, 18)

-- ============================================================= DECKBOSS TAB ==
-- v1.3: top-down deck view.  dxgui can't draw shapes, so the deck "silhouette"
-- is painted with labeled landmark widgets at fixed positions (BOW / CATs /
-- ISLAND / JUNKYARD / etc).  The hook reads carriergui_deck.txt — one line per
-- aircraft on deck with (along, across) carrier-frame offsets in metres — and
-- moves a pool of 16 modex slot widgets to the closest deck zone.  View only.
local DeckSkin = mkLabelSkin("0x80c0a0ff", 14)
local DeckHdr  = mkLabelSkin("0x60d088ff", 18)

c.lblDbHdr      = lbl("DECK VIEW  ·  CVN top-down  (port = top)", PAD, 30, W - PAD*2, LabelSkin, 18)

-- Deck zone labels — fixed positions roughly matching a Nimitz layout.
-- Coordinate system: ship-nose is at x=80, stern at x=440.  Port is up.
c.lblDbBow      = lbl("BOW",         60,  60, 60, DeckSkin, 16)
c.lblDbCat1     = lbl("CAT 1",      110,  80, 60, DeckHdr,  16)
c.lblDbCat2     = lbl("CAT 2",      110, 110, 60, DeckHdr,  16)
c.lblDbCat3     = lbl("CAT 3",      220,  80, 60, DeckHdr,  16)
c.lblDbCat4     = lbl("CAT 4",      220, 110, 60, DeckHdr,  16)
c.lblDbIsland   = lbl("[ ISLAND ]", 280, 140, 100, DeckSkin, 18)
c.lblDb6pk      = lbl("6-PACK",     180, 175, 70, DeckSkin, 16)
c.lblDbWaist    = lbl("WAIST",       80, 175, 60, DeckSkin, 16)
c.lblDbElev1    = lbl("EL1",        310, 100, 30, DeckSkin, 14)
c.lblDbElev2    = lbl("EL2",        390, 110, 30, DeckSkin, 14)
c.lblDbElev3    = lbl("EL3",        310, 200, 30, DeckSkin, 14)
c.lblDbElev4    = lbl("EL4",        430, 195, 30, DeckSkin, 14)
c.lblDbJunk     = lbl("JUNKYARD",   380, 230, 100, DeckHdr,  16)
c.lblDbStern    = lbl("STERN",      470, 270, 60, DeckSkin, 16)

-- Aircraft modex slot pool (16 max).  Hook moves visible ones into the deck
-- area, hides unused via setBounds off-screen.
for i = 1, 16 do
    c["spotDb" .. i] = lbl("", -200, -200, 60, ValueSkin, 16)
end

-- ON DECK summary list (one line per aircraft).
c.lblDbOnDeckHdr  = lbl("ON DECK",                                  PAD, 320, W - PAD*2, LabelSkin, 18)
c.lblDbOnDeckCols = lbl("  MODEX     ALONG       ACROSS     ZONE",  PAD, 340, W - PAD*2, CapSkin,   16)
for i = 1, 10 do
    c["rowDbOnDeck" .. i] = lbl("", PAD, 358 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- Conga toggle (visual hint only; v1.3-beta5 just flips a state label so the
-- user can see the toggle works.  Path overlay drawn later if the layout sticks.)
c.lblDbCongaState = lbl("CONGA LINE:  OFF", PAD,        540, 200, ValueSkin, 20)
c.btnDbConga      = btn("TOGGLE CONGA",     PAD + 220,  540, 150)
c.lblDbCongaHint  = lbl("(path overlay disabled in beta — preview only)",
                        PAD, 568, W - PAD*2, CapSkin, 16)

-- ================================================================= LSO TAB ==
-- v1.3: rebuilt.  Layout top → bottom:
--   1. CASE I PATTERN  — list view, one row per pattern point (INITIAL,
--      BREAK, DOWNWIND, ABEAM, 180, GROOVE, TRAP).  Each row shows the
--      modex/alt/spd of whoever the bridge classified at that point.
--   2. LSO LIGHTS      — big WAVE OFF (red) + CUT (green) buttons.  They
--      latch lit for ~5s after press (hook-side state + setSkin swap).
--   3. PLAT CAMERA     — existing NVG bar + RESET CAM (text-block style).
--      Wire/Deck/Zoom buttons RETIRED in v1.3 (didn't do what we hoped
--      in-game).  Bingo/RecovOK also retired — kept on hook side as
--      F10 calls instead.
--   4. SHIP            — live HDG / wind from bridge.
--   5. RECOVERY EVENTS — last 3 LSO prompts (CASE III monitor still wired).

-- ── CASE I PATTERN ──────────────────────────────────────────
c.lblPatHdr   = lbl("CASE I OVERHEAD",                          PAD,  30, W - PAD*2, LabelSkin, 18)
c.lblPatCols  = lbl("  POINT       MODEX    ALT       SPD",     PAD,  50, W - PAD*2, CapSkin,   16)
-- One row per pattern point.  Hook fills MODEX / ALT / SPD from
-- carriergui_pattern.txt and writes "—" when the slot is empty.
c.rowPatInit  = lbl("  INITIAL     —",                          PAD,  70, W - PAD*2, RowSkinMon, 15)
c.rowPatBrk   = lbl("  BREAK       —",                          PAD,  86, W - PAD*2, RowSkinMon, 15)
c.rowPatDwn   = lbl("  DOWNWIND    —",                          PAD, 102, W - PAD*2, RowSkinMon, 15)
c.rowPatAbm   = lbl("  ABEAM       —",                          PAD, 118, W - PAD*2, RowSkinMon, 15)
c.rowPat180   = lbl("  180         —",                          PAD, 134, W - PAD*2, RowSkinMon, 15)
c.rowPatGrv   = lbl("  GROOVE      —",                          PAD, 150, W - PAD*2, RowSkinMon, 15)
c.rowPatTrap  = lbl("  TRAP        —",                          PAD, 166, W - PAD*2, RowSkinMon, 15)

-- ── LSO LIGHTS ─────────────────────────────────────────────
c.lblLightsHdr = lbl("LSO LIGHTS",                              PAD, 195, W - PAD*2, LabelSkin, 18)
-- WAVE OFF and CUT are oversized (h=60) so they read as actual lights
-- in VR.  The hook latches their skin to a "lit" colour for ~5s after
-- press so an LSO across the room can see they fired.
c.btnWaveOff  = btn("WAVE OFF",  PAD,           220, 250)
c.btnCut      = btn("CUT",       PAD + 256,     220, 250)
-- Bump button heights via direct mutation (btn() forces h=BTN_H=26).
c.btnWaveOff.params.bounds.h = 60
c.btnCut.params.bounds.h     = 60

-- ── PLAT CAMERA  (NVG + RESET CAM kept; Wire/Deck/Zoom RETIRED) ──
c.lblLsoNvg   = lbl("PLAT NVG GAIN",                            PAD,  295, 240, LabelSkin, 18)
c.btnResetCam = btn("RESET CAM",                    W - PAD - 110,  295, 110)

local BigSkin = mkLabelSkin("0xffffffff", 36)
c.lblNvgVal   = lbl("OFF", 110, 317, 160, BigSkin, 48)

local LedFull = mkLabelSkin("0x60ff80ff", 28)
local BLK = "\226\150\136"   -- "█" U+2588 via decimal escape
c.ledNvg1  = lbl(BLK,  41, 371, 28, LedFull, 36)
c.ledNvg2  = lbl(BLK,  71, 371, 28, LedFull, 36)
c.ledNvg3  = lbl(BLK, 101, 371, 28, LedFull, 36)
c.ledNvg4  = lbl(BLK, 131, 371, 28, LedFull, 36)
c.ledNvg5  = lbl(BLK, 161, 371, 28, LedFull, 36)
c.ledNvg6  = lbl(BLK, 191, 371, 28, LedFull, 36)
c.ledNvg7  = lbl(BLK, 221, 371, 28, LedFull, 36)
c.ledNvg8  = lbl(BLK, 251, 371, 28, LedFull, 36)
c.ledNvg9  = lbl(BLK, 281, 371, 28, LedFull, 36)
c.ledNvg10 = lbl(BLK, 311, 371, 28, LedFull, 36)

local TickSkin = mkLabelSkin("0xa0a0a0ff", 12)
c.lblTick0   = lbl("0%",     35, 411, 40, TickSkin, 14)
c.lblTick50  = lbl("50%",   165, 411, 40, TickSkin, 14)
c.lblTick100 = lbl("100%",  305, 411, 50, TickSkin, 14)

-- ── SHIP STATUS (live readout from the bridge) ────────────
c.lblShipHdr  = lbl("SHIP",                   PAD,        450, 240, LabelSkin, 18)
c.lblShipHdg  = lbl("HDG: --",                PAD,        472, 170, ValueSkin, 20)
c.lblShipWind = lbl("Wind: --/-- kts",        PAD + 181,  472, 350, ValueSkin, 20)

-- ── RECOVERY EVENTS — LSO prompt log (3 most recent lines) ─────────
c.lblEventsHdr = lbl("RECOVERY EVENTS",                  PAD, 510, 240, LabelSkin, 18)
local EventSkin = mkLabelSkin("0xeaeaeaff", 14)
c.lblEvent1 = lbl("(waiting for inbound aircraft...)",   PAD, 535, W - PAD*2, EventSkin, 18)
c.lblEvent2 = lbl("",                                    PAD, 557, W - PAD*2, EventSkin, 18)
c.lblEvent3 = lbl("",                                    PAD, 579, W - PAD*2, EventSkin, 18)

c.lblNvgState = lbl("Bridge: probing...",                PAD, 615, W - PAD*2, CapSkin, 18)

-- ============================================================= SHARED STATUS ==
local StatusSkin = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = true },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xaaaaaaff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = 12,
                },
            },
        },
    },
}
c.lblStatus = {
    ["params"] = {
        ["bounds"]  = { ["h"] = 40, ["w"] = W - PAD*2, ["x"] = PAD, ["y"] = H - 50 },
        ["enabled"] = true,
        ["text"]    = "Bridge: checking...",
        ["tooltip"] = "",
        ["visible"] = true,
        ["zindex"]  = 0,
    },
    ["skin"] = StatusSkin,
    ["type"] = "Static",
}
