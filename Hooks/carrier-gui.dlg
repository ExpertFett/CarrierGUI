c.lblDbStern    = lbl("STERN",      252, 340, 60, DeckSkin, 14)

-- Aircraft modex slot pool — hook moves visible ones into position.
for i = 1, 16 do
    c["spotDb" .. i] = lbl("", -200, -200, 50, SpotSkin, 14)
end

-- ON DECK summary list (one line per aircraft, below the deck silhouette).
c.lblDbOnDeckHdr  = lbl("ON DECK",                                  PAD, 380, W - PAD*2, LabelSkin, 18)
c.lblDbOnDeckCols = lbl("  MODEX     ALONG       ACROSS     ZONE",  PAD, 400, W - PAD*2, CapSkin,   14)
for i = 1, 10 do
    c["rowDbOnDeck" .. i] = lbl("", PAD, 418 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
