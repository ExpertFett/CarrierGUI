-- CarrierGUI dialog layout  (v1.3-beta56 — login + 4-tab + LIVE rescale + tacview LSO)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.
--
-- beta50 layout: a LOGIN front door + 4 tabs + OUT (logout) button.
--   LOGIN     — Olympus host/port/password (EditBoxes) + CONNECT, or
--               LOCAL / HOST MODE for the classic SP/listen-host path.
--               Owns the window until logged in; tab bar hidden.
--   MARSHALL  — CCZ 60nm radar + radio readout + stack/table + wind/CASE/broadcast
--   TOWER     — marshal-stack manager (CASE I circle / CASE III racetrack)
--   LSO       — pattern radar + groove timer + PLAT NVG + ship/events/sequence
--   DECKBOSS  — top-down deck image + live overlay + lights/beacons (SHIP SYSTEMS)
--   (CARRIER + ELEVATOR tabs retired; their controls moved as noted above.)
--
-- Panel widened from 380→540 to make room for the radars in later betas.

local W = 540       -- window width  (was 380 in v1.2)
local H = 940       -- window height (beta43: +40 for the LSO ON APPROACH list)
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

-- ── UI SCALE ────────────────────────────────────────────────────────────────
-- Pure-arithmetic scaling baked into every constructor below — the DialogLoader
-- environment has NO globals (no io/pcall/pairs), which is why the previous
-- file-reading scale block killed the whole dialog.  The HOOK owns the file
-- I/O: its UI SIZE button rewrites the line below in place; next spawn builds
-- at that size.  Keep the marker comment EXACTLY — the hook pattern-matches it.
local SCALE = 1.00 -- CARRIERGUI_UI_SCALE
local function S(v)
    local r = v * SCALE + 0.5
    return r - (r % 1)
end

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = S(size or 14),
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

-- v1.3-beta29: ALL non-base skins declared up front so every tab section can
-- reference them (latent forward-ref bug in beta5 made TOWER rows fall back
-- to LabelSkin silently — that's why the panel "looked like the old version").
local SubSkin     = mkLabelSkin("0xccccccff", 16)
local RowSkin     = mkLabelSkin("0xe0e0e0ff", 14)
local RowSkinMon  = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xe0e0e0ff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = S(14),
                },
            },
        },
    },
}
local DeckSkin    = mkLabelSkin("0x80c0a0ff", 14)   -- deck zone landmarks (teal)
local DeckHdr     = mkLabelSkin("0x60d088ff", 18)   -- deck zone headers (bright teal)
local CarrierMark = mkLabelSkin("0xff8040ff", 18)   -- carrier centre dot (amber-red)
local SpotSkin    = mkLabelSkin("0xffff00ff", 14)   -- modex labels (bright yellow)
local RadarLbl    = mkLabelSkin("0xb8c8d8ff", 12)   -- range/alt scale ticks

-- v1.3-beta29 Z-ORDER SCHEME (zindex):
--   0 = whole-panel dark backdrop
--   1 = scope/deck base fills
--   2 = secondary fills (angled deck strip, island, elevators)
--   3 = structure lines, rings, arcs, crosshairs, cat tracks
--   4 = ALL text labels and buttons
local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = S(BTN_H), ["w"] = S(w or BTN_W), ["x"] = S(x), ["y"] = S(y) },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 4,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = S(h or 18), ["w"] = S(w or 200), ["x"] = S(x), ["y"] = S(y) },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 4,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

-- ---------------------------------------------------------------------------
-- v1.3-beta29 DRAWING PRIMITIVES — copied from the stock Supercarrier dialogs
-- (FLOLS.dlg): a skin state can carry a ["bkg"] block of nine cell colours,
-- which renders the widget as a SOLID FILLED RECTANGLE — no image file, no
-- font involved.  Combined with params ["angle"] + ["pivotPoint"] (also used
-- by stock dialogs) a thin rectangle becomes a drawable line segment at any
-- angle: range rings, racetrack arcs, deck edges, catapult tracks.
local function mkSolidSkin(color)
    return {
        ["params"] = { ["name"] = "staticSkin" },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["bkg"] = {
                        ["center_bottom"] = color,
                        ["center_center"] = color,
                        ["center_top"]    = color,
                        ["left_bottom"]   = color,
                        ["left_center"]   = color,
                        ["left_top"]      = color,
                        ["right_bottom"]  = color,
                        ["right_center"]  = color,
                        ["right_top"]     = color,
                    },
                },
            },
        },
    }
end

local PANEL_BG_SKIN  = mkSolidSkin("0x10161aff")   -- whole-panel dark backdrop
local SCOPE_BG_SKIN  = mkSolidSkin("0x0a2010ff")   -- CRT scope dark green
local SCOPE_LN_SKIN  = mkSolidSkin("0x2a5a38ff")   -- dim green crosshair/gridlines
local SCOPE_RG_SKIN  = mkSolidSkin("0x4cc878ff")   -- track green (LSO/TOWER)
local SCOPE_RING_SKIN= mkSolidSkin("0x5fe08aff")   -- bright light-green range rings
local DECK_FILL_SKIN = mkSolidSkin("0x232a2eff")   -- carrier deck steel
local DECK_STRP_SKIN = mkSolidSkin("0x2c343aff")   -- angled landing-area strip
local DECK_EDGE_SKIN = mkSolidSkin("0x55656eff")   -- deck edge lines
local ISLAND_SKIN    = mkSolidSkin("0x3c464cff")   -- island block
local ELEV_SKIN      = mkSolidSkin("0x303a40ff")   -- elevator plates
local CAT_SKIN       = mkSolidSkin("0x9a8838ff")   -- catapult tracks (dull yellow)
local SHIP_MARK_SKIN = mkSolidSkin("0xcc8030ff")   -- own-ship marker (amber)
local TRANSPARENT_SKIN = mkSolidSkin("0x00000000") -- fully transparent (image-overlay placeholder)
local CONTACT_SKIN     = mkSolidSkin("0xffe000ff") -- radar contact blip (bright yellow)
local DECK_BLIP_SKIN   = mkSolidSkin("0x20e0ffff") -- DECKBOSS aircraft blip (bright cyan — pops on the busy deck image)

local function solidW(x, y, w, h, skin, z)
    return {
        ["params"] = {
            ["angle"]      = 0,
            ["bounds"]     = { ["h"] = S(h), ["w"] = S(w), ["x"] = S(x), ["y"] = S(y) },
            -- enabled=true: disabled statics ignore setVisible(), which let
            -- LSO/DECKBOSS drawings bleed across tabs (beta10 field bug).
            ["enabled"]    = true,
            ["pivotPoint"] = { ["x"] = 0, ["y"] = 0 },
            ["text"]       = "",
            ["tooltip"]    = "",
            ["visible"]    = true,
            ["zindex"]     = z or 3,
        },
        ["skin"] = skin,
        ["type"] = "Static",
    }
end

-- Rotated ring/arc segment.  Pivot at the segment centre so the generated
-- geometry (Tools/gen_radar_geometry.py) just supplies top-left + angle.
-- If a DCS build ignores ["angle"], segments render unrotated — which still
-- reads as a dashed circle, an acceptable failure mode.
local function seg(x, y, w, h, angle)
    local t = solidW(x, y, w, h, SCOPE_RG_SKIN, 3)
    t.params.angle = angle
    t.params.pivotPoint = { ["x"] = t.params.bounds.w / 2, ["y"] = t.params.bounds.h / 2 }
    return t
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]     = { ["h"] = S(H), ["w"] = S(W), ["x"] = 200, ["y"] = 100 },
        ["enabled"]    = true,
        ["text"]       = "Carrier Control",
        ["tooltip"]    = "",
        ["visible"]    = false,         -- hook flips to true after creation
        ["zindex"]     = 0,
        -- resizable = the kneeboard-style drag grip.  The frame alone can't
        -- reflow content (drag shows a grey box) — but the HOOK watches the
        -- frame size and on release rebuilds the whole panel at the dragged
        -- width (live rescale, no restart).
        ["resizable"]  = true,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- Whole-panel dark backdrop — always visible on every tab (deliberately not
-- in any tab's widget list).  This is what kills the stock gray window look.
c.bgPanel = solidW(2, 32, W - 4, H - 36, PANEL_BG_SKIN, 0)

-- ---------------------------------------------------------------- TAB BAR ---
-- beta50: 4 tabs + a small LOG OUT button.  The tab bar is HIDDEN until the
-- user logs in (Olympus) or picks local mode — the LOGIN tab owns the window
-- until then.  4*118 + 3*6 = 490; OUT at 502 (32 wide) ends 534 = W-PAD.
local TAB_W, TAB_GAP = 118, 6
c.btnTabMarshall = btn("MARSHALL", PAD + (TAB_W+TAB_GAP)*0, 4, TAB_W)
c.btnTabTower    = btn("TOWER",    PAD + (TAB_W+TAB_GAP)*1, 4, TAB_W)
c.btnTabLso      = btn("LSO",      PAD + (TAB_W+TAB_GAP)*2, 4, TAB_W)
c.btnTabDeckboss = btn("DECKBOSS", PAD + (TAB_W+TAB_GAP)*3, 4, TAB_W)
c.btnLogout      = btn("OUT",      502, 4, 32)

-- =============================================================== LOGIN TAB ==
-- beta50: Olympus login IS the front door.  Enter the squad's Olympus host +
-- Game-master password (same login as Olympus / OPT Live), press CONNECT, and
-- the login tab disappears — replaced by the standard tabs, fed live from
-- Olympus (full picture, no mission patch, no agents).  LOCAL / HOST MODE
-- keeps the classic behavior for SP / listen-host (reads the local mission).
-- EditBox shaped exactly like the stock ME dialogs (DateTime.dlg): type
-- "EditBox", skin "editBoxNew", dark translucent field background.
local function edit(text, x, y, w, password)
    return {
        ["params"] = {
            ["acceptDecimalPoint"] = false,
            ["bounds"]  = { ["h"] = S(28), ["w"] = S(w), ["x"] = S(x), ["y"] = S(y) },
            ["enabled"] = true,
            ["multiline"] = false,
            ["numeric"] = false,
            ["password"] = password or false,
            ["text"]    = text or "",
            ["textWrapping"] = true,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 4,
        },
        ["skin"] = {
            ["params"] = { ["name"] = "editBoxNew" },
            ["states"] = {
                ["released"] = {
                    [2] = {
                        ["bkg"] = {
                            ["center_bottom"] = "0x00000080",
                            ["center_top"]    = "0x00000080",
                            ["left_bottom"]   = "0x00000080",
                            ["left_center"]   = "0x00000080",
                            ["left_top"]      = "0x00000080",
                            ["right_bottom"]  = "0x00000080",
                            ["right_center"]  = "0x00000080",
                            ["right_top"]     = "0x00000080",
                        },
                    },
                },
            },
        },
        ["type"] = "EditBox",
    }
end

