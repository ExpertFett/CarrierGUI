    c3.params.angle = -12
    c3.params.pivotPoint = { ["x"] = 1, ["y"] = 38 }
    c.dbCat3 = c3
    local c4 = solidW(318, 158,   3,  76, CAT_SKIN, 3)
    c4.params.angle = -12
    c4.params.pivotPoint = { ["x"] = 1, ["y"] = 38 }
    c.dbCat4 = c4
end
