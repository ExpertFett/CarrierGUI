c.ledNvg5  = lbl(BLK, 161, 471, 28, LedFull, 36)
c.ledNvg6  = lbl(BLK, 191, 471, 28, LedFull, 36)
c.ledNvg7  = lbl(BLK, 221, 471, 28, LedFull, 36)
c.ledNvg8  = lbl(BLK, 251, 471, 28, LedFull, 36)
c.ledNvg9  = lbl(BLK, 281, 471, 28, LedFull, 36)
c.ledNvg10 = lbl(BLK, 311, 471, 28, LedFull, 36)

