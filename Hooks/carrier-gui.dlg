      ["enabled"] = true, ["visible"] = true, ["zindex"] = 3, ["text"] = "", ["tooltip"] = "" },
    ["skin"] = { ["params"] = { ["name"] = "staticSkin" }, ["states"] = { ["released"] = { [1] = { ["bkg"] = {
      ["center_bottom"]=W9, ["center_center"]=W9, ["center_top"]=W9,
      ["left_bottom"]=W9,   ["left_center"]=W9,   ["left_top"]=W9,
      ["right_bottom"]=W9,  ["right_center"]=W9,  ["right_top"]=W9,
      ["file"]   = "mods\\tech\\supercarrier\\platcameraui\\carriergui_deck.tga",
      ["rect"]   = { ["x1"]=0, ["y1"]=0, ["x2"]=520, ["y2"]=139 },
      ["insets"] = { ["top"]=0, ["bottom"]=0, ["left"]=0, ["right"]=0 },
    } } } } },
    ["type"] = "Static",
  }
end

-- Aircraft pool — cyan blip + a DATABLOCK with its own dark backing so the
-- modex stays readable over the busy multicolor deck (text never fights the
-- deck underneath).  Bright white text on a near-opaque dark pill.
