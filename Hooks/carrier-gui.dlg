c.lblDbStbdV12  = lbl("│", 410, 312, 12, OutlineSkin, 18)
-- Stern horizontal edge (y=335)
c.lblDbStnH1    = lbl("──", 140, 335, 30, OutlineSkin, 16)
c.lblDbStnH2    = lbl("──", 170, 335, 30, OutlineSkin, 16)
