-- CarrierGUI dialog layout  (v1.3-beta9 — 5-tab skeleton)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.
--
-- v1.3 layout: 5 tabs across the top.
--   CARRIER   — F10 menu controls (lights, beacons, wind) — UNCHANGED in beta1
--   MARSHALL  — NEW. CCZ 60nm radar + radio readout (placeholder in beta1)
--   TOWER     — RENAMED from old MARSHALL. CASE / Charlie / stack broadcasts
--   LSO       — PLAT NVG + camera controls. UNCHANGED in beta1 (overhead
--               pattern + drop-of-Wire/Deck/Zoom arrives in beta4)
--   DECKBOSS  — NEW. Top-down deck view (placeholder in beta1)
--
-- Panel widened from 380→540 to make room for the radars in later betas.

local W = 540       -- window width  (was 380 in v1.2)
local H = 900       -- window height (was 800 in beta5; bumped for radar overlays)
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = size or 14,
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

-- v1.3-beta9: ALL non-base skins declared up front so every tab section can
-- reference them (latent forward-ref bug in beta5 made TOWER rows fall back
-- to LabelSkin silently — that's why the panel "looked like the old version").
local SubSkin     = mkLabelSkin("0xccccccff", 16)
local RowSkin     = mkLabelSkin("0xe0e0e0ff", 14)
local RowSkinMon  = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xe0e0e0ff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = 14,
                },
            },
        },
    },
}
local DeckSkin    = mkLabelSkin("0x80c0a0ff", 14)   -- deck zone landmarks (teal)
local DeckHdr     = mkLabelSkin("0x60d088ff", 18)   -- deck zone headers (bright teal)
local CarrierMark = mkLabelSkin("0xff8040ff", 18)   -- carrier centre dot (amber-red)
local SpotSkin    = mkLabelSkin("0xffff00ff", 14)   -- modex labels (bright yellow)
local RadarLbl    = mkLabelSkin("0xb8c8d8ff", 12)   -- range/alt scale ticks

-- v1.3-beta9 Z-ORDER SCHEME (zindex):
--   0 = whole-panel dark backdrop
--   1 = scope/deck base fills
--   2 = secondary fills (angled deck strip, island, elevators)
--   3 = structure lines, rings, arcs, crosshairs, cat tracks
--   4 = ALL text labels and buttons
local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = BTN_H, ["w"] = w or BTN_W, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 4,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = h or 18, ["w"] = w or 200, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 4,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

-- ---------------------------------------------------------------------------
-- v1.3-beta9 DRAWING PRIMITIVES — copied from the stock Supercarrier dialogs
-- (FLOLS.dlg): a skin state can carry a ["bkg"] block of nine cell colours,
-- which renders the widget as a SOLID FILLED RECTANGLE — no image file, no
-- font involved.  Combined with params ["angle"] + ["pivotPoint"] (also used
-- by stock dialogs) a thin rectangle becomes a drawable line segment at any
-- angle: range rings, racetrack arcs, deck edges, catapult tracks.
local function mkSolidSkin(color)
    return {
        ["params"] = { ["name"] = "staticSkin" },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["bkg"] = {
                        ["center_bottom"] = color,
                        ["center_center"] = color,
                        ["center_top"]    = color,
                        ["left_bottom"]   = color,
                        ["left_center"]   = color,
                        ["left_top"]      = color,
                        ["right_bottom"]  = color,
                        ["right_center"]  = color,
                        ["right_top"]     = color,
                    },
                },
            },
        },
    }
end

local PANEL_BG_SKIN  = mkSolidSkin("0x10161aff")   -- whole-panel dark backdrop
local SCOPE_BG_SKIN  = mkSolidSkin("0x081008ff")   -- CRT scope near-black green
local SCOPE_LN_SKIN  = mkSolidSkin("0x1a3a24ff")   -- dim green gridlines
local SCOPE_RG_SKIN  = mkSolidSkin("0x2e7a46ff")   -- ring / track green
local DECK_FILL_SKIN = mkSolidSkin("0x232a2eff")   -- carrier deck steel
local DECK_STRP_SKIN = mkSolidSkin("0x2c343aff")   -- angled landing-area strip
local DECK_EDGE_SKIN = mkSolidSkin("0x55656eff")   -- deck edge lines
local ISLAND_SKIN    = mkSolidSkin("0x3c464cff")   -- island block
local ELEV_SKIN      = mkSolidSkin("0x303a40ff")   -- elevator plates
local CAT_SKIN       = mkSolidSkin("0x9a8838ff")   -- catapult tracks (dull yellow)
local SHIP_MARK_SKIN = mkSolidSkin("0xcc8030ff")   -- own-ship marker (amber)

local function solidW(x, y, w, h, skin, z)
    return {
        ["params"] = {
            ["angle"]      = 0,
            ["bounds"]     = { ["h"] = h, ["w"] = w, ["x"] = x, ["y"] = y },
            ["enabled"]    = false,
            ["pivotPoint"] = { ["x"] = 0, ["y"] = 0 },
            ["text"]       = "",
            ["tooltip"]    = "",
            ["visible"]    = true,
            ["zindex"]     = z or 3,
        },
        ["skin"] = skin,
        ["type"] = "Static",
    }
end

-- Rotated ring/arc segment.  Pivot at the segment centre so the generated
-- geometry (Tools/gen_radar_geometry.py) just supplies top-left + angle.
-- If a DCS build ignores ["angle"], segments render unrotated — which still
-- reads as a dashed circle, an acceptable failure mode.
local function seg(x, y, w, h, angle)
    local t = solidW(x, y, w, h, SCOPE_RG_SKIN, 3)
    t.params.angle = angle
    t.params.pivotPoint = { ["x"] = w / 2, ["y"] = h / 2 }
    return t
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]  = { ["h"] = H, ["w"] = W, ["x"] = 200, ["y"] = 100 },
        ["enabled"] = true,
        ["text"]    = "Carrier Control",
        ["tooltip"] = "",
        ["visible"] = false,            -- hook flips to true after creation
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- Whole-panel dark backdrop — always visible on every tab (deliberately not
-- in any tab's widget list).  This is what kills the stock gray window look.
c.bgPanel = solidW(2, 32, W - 4, H - 36, PANEL_BG_SKIN, 0)

-- ---------------------------------------------------------------- TAB BAR ---
-- v1.3-beta9: 5 tabs across the top in a wider (540 px) window.
-- Each tab = 100 wide, 6 px gap. Total span: 5*100 + 4*6 = 524 < 540-PAD*2.
c.btnTabCarrier  = btn("CARRIER",  PAD + (100+6)*0, 4, 100)
c.btnTabMarshall = btn("MARSHALL", PAD + (100+6)*1, 4, 100)
c.btnTabTower    = btn("TOWER",    PAD + (100+6)*2, 4, 100)
c.btnTabLso      = btn("LSO",      PAD + (100+6)*3, 4, 100)
c.btnTabDeckboss = btn("DECKBOSS", PAD + (100+6)*4, 4, 100)

