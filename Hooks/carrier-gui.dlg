-- CarrierGUI dialog layout  (v1.3-beta7 — 5-tab skeleton)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.
--
-- v1.3 layout: 5 tabs across the top.
--   CARRIER   — F10 menu controls (lights, beacons, wind) — UNCHANGED in beta1
--   MARSHALL  — NEW. CCZ 60nm radar + radio readout (placeholder in beta1)
--   TOWER     — RENAMED from old MARSHALL. CASE / Charlie / stack broadcasts
--   LSO       — PLAT NVG + camera controls. UNCHANGED in beta1 (overhead
--               pattern + drop-of-Wire/Deck/Zoom arrives in beta4)
--   DECKBOSS  — NEW. Top-down deck view (placeholder in beta1)
--
-- Panel widened from 380→540 to make room for the radars in later betas.

local W = 540       -- window width  (was 380 in v1.2)
local H = 900       -- window height (was 800 in beta5; bumped for radar overlays)
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = size or 14,
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

-- v1.3-beta7: ALL non-base skins declared up front so every tab section can
-- reference them (latent forward-ref bug in beta5 made TOWER rows fall back
-- to LabelSkin silently — that's why the panel "looked like the old version").
local SubSkin     = mkLabelSkin("0xccccccff", 16)
local RowSkin     = mkLabelSkin("0xe0e0e0ff", 14)
local RowSkinMon  = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xe0e0e0ff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = 14,
                },
            },
        },
    },
}
local DeckSkin    = mkLabelSkin("0x80c0a0ff", 14)   -- deck zone landmarks (teal)
local DeckHdr     = mkLabelSkin("0x60d088ff", 18)   -- deck zone headers (bright teal)
local CarrierMark = mkLabelSkin("0xff8040ff", 18)   -- carrier centre dot (amber-red)
local SpotSkin    = mkLabelSkin("0xffff00ff", 14)   -- modex labels (bright yellow)
local RadarLbl    = mkLabelSkin("0x808080ff", 12)   -- range/alt scale ticks

local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = BTN_H, ["w"] = w or BTN_W, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = h or 18, ["w"] = w or 200, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]  = { ["h"] = H, ["w"] = W, ["x"] = 200, ["y"] = 100 },
        ["enabled"] = true,
        ["text"]    = "Carrier Control",
        ["tooltip"] = "",
        ["visible"] = false,            -- hook flips to true after creation
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- ---------------------------------------------------------------- TAB BAR ---
-- v1.3-beta7: 5 tabs across the top in a wider (540 px) window.
-- Each tab = 100 wide, 6 px gap. Total span: 5*100 + 4*6 = 524 < 540-PAD*2.
c.btnTabCarrier  = btn("CARRIER",  PAD + (100+6)*0, 4, 100)
c.btnTabMarshall = btn("MARSHALL", PAD + (100+6)*1, 4, 100)
c.btnTabTower    = btn("TOWER",    PAD + (100+6)*2, 4, 100)
c.btnTabLso      = btn("LSO",      PAD + (100+6)*3, 4, 100)
c.btnTabDeckboss = btn("DECKBOSS", PAD + (100+6)*4, 4, 100)

-- =============================================================== CARRIER TAB ==
local y = 40
c.lblLights         = lbl("LIGHTS", PAD, y)
y = y + 22
c.btnLightsOff      = btn("Off",      PAD + (BTN_W+PAD)*0, y)
c.btnLightsAuto     = btn("Auto",     PAD + (BTN_W+PAD)*1, y)
c.btnLightsNav      = btn("Nav",      PAD + (BTN_W+PAD)*2, y)
c.btnLightsLaunch   = btn("Launch",   PAD + (BTN_W+PAD)*3, y)
y = y + BTN_H + PAD
c.btnLightsRecovery = btn("Recovery", PAD, y, BTN_W*2 + PAD)

y = y + BTN_H + PAD*2
c.lblTacan          = lbl("TACAN", PAD, y)
y = y + 22
c.btnTacanOn        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnTacanOff       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblIcls           = lbl("ICLS", PAD, y)
y = y + 22
c.btnIclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnIclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblLink4          = lbl("LINK 4", PAD, y)
y = y + 22
c.btnLink4On        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnLink4Off       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblAcls           = lbl("ACLS", PAD, y)
y = y + 22
c.btnAclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnAclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblWind           = lbl("TURN INTO WIND", PAD, y, 250)
y = y + 22
local wb = 48
c.btnWindStop = btn("Stop", PAD + (wb+4)*0, y, wb)
c.btnWind30m  = btn("30m",  PAD + (wb+4)*1, y, wb)
c.btnWind60m  = btn("60m",  PAD + (wb+4)*2, y, wb)
c.btnWind90m  = btn("90m",  PAD + (wb+4)*3, y, wb)
c.btnWind2h   = btn("2h",   PAD + (wb+4)*4, y, wb)
c.btnWind4h   = btn("4h",   PAD + (wb+4)*5, y, wb)
c.btnWind8h   = btn("8h",   PAD + (wb+4)*6, y, wb)

-- ================================================================= TOWER TAB ==
-- v1.3-beta7: layout top → bottom:
--   1. Mini overhead radar (left) + side view (right)  y=30..160
--   2. STACK / CHARLIE'D / COMMENCING rosters          y=170..580
--   3. Existing broadcast controls                     y=600..830
-- Mini-radar slot widgets (twrOh*, twrSv*) start off-screen; the hook
-- repositions them every poll from carriergui_stack.txt.

-- --- Mini overhead radar (carrier at centre, 25nm scale, left half) ----------
c.lblTwrOhHdr   = lbl("OVERHEAD  ·  25 nm",            PAD,     30, 250, CapSkin,  14)
c.lblTwrOhN     = lbl("N",                             125,     46, 14, RadarLbl, 12)
c.lblTwrOhE     = lbl("E",                             225,    100, 14, RadarLbl, 12)
c.lblTwrOhS     = lbl("S",                             125,    150, 14, RadarLbl, 12)
c.lblTwrOhW     = lbl("W",                              25,    100, 14, RadarLbl, 12)
c.lblTwrOhCv    = lbl("CV",                            125,    100, 24, CarrierMark, 14)
for i = 1, 10 do
    c["twrOh" .. i] = lbl("", -200, -200, 40, SpotSkin, 14)
end

-- --- Mini side view (altitude profile, right half) ---------------------------
c.lblTwrSvHdr   = lbl("ALT  ·  0 → 15k ft",            290,    30, 250, CapSkin,  14)
c.lblTwrSvA15   = lbl("15k",                           290,    50, 26, RadarLbl, 12)
c.lblTwrSvA12   = lbl("12k",                           290,    74, 26, RadarLbl, 12)
c.lblTwrSvA9    = lbl(" 9k",                           290,    98, 26, RadarLbl, 12)
c.lblTwrSvA6    = lbl(" 6k",                           290,   122, 26, RadarLbl, 12)
c.lblTwrSvA3    = lbl(" 3k",                           290,   146, 26, RadarLbl, 12)
for i = 1, 10 do
    c["twrSv" .. i] = lbl("", -200, -200, 40, SpotSkin, 14)
end

-- --- STACK roster (HOLD aircraft, sorted alt-desc) ----------------------------
c.lblTwrStackHdr  = lbl("STACK  ·  holding",                            PAD, 170, W - PAD*2, LabelSkin, 18)
c.lblTwrStackCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",  PAD, 190, W - PAD*2, CapSkin,   16)
for i = 1, 8 do
    c["rowTwrStack" .. i] = lbl("", PAD, 208 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- CHARLIE'D roster (cleared to commence) ----------------------------------
c.lblTwrCharlieHdr  = lbl("CHARLIE'D  ·  cleared to commence",            PAD, 340, W - PAD*2, LabelSkin, 18)
c.lblTwrCharlieCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",  PAD, 360, W - PAD*2, CapSkin,   16)
for i = 1, 5 do
    c["rowTwrCharlie" .. i] = lbl("", PAD, 378 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- COMMENCING roster (past commence point) ---------------------------------
c.lblTwrCommHdr  = lbl("COMMENCING  ·  past commence point",              PAD, 465, W - PAD*2, LabelSkin, 18)
c.lblTwrCommCols = lbl("  #  MODEX    ALT     IAS  IN-STK   LAST PT",     PAD, 485, W - PAD*2, CapSkin,   16)
for i = 1, 5 do
    c["rowTwrComm" .. i] = lbl("", PAD, 503 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- --- Existing broadcast controls at the bottom -------------------------------
local my = 600
c.lblMarCase = lbl("RECOVERY CASE", PAD, my)
my = my + 22
c.btnCase1 = btn("CASE I",   PAD + (114+PAD)*0, my, 114)
c.btnCase2 = btn("CASE II",  PAD + (114+PAD)*1, my, 114)
c.btnCase3 = btn("CASE III", PAD + (114+PAD)*2 - 116, my + 0, 114)
-- third button on next position; keep 3 across if width allows, else wrap
c.btnCase3.params.bounds.x = PAD + (114+PAD)*2
my = my + BTN_H + PAD*2

c.lblMarStack = lbl("MARSHAL STACK", PAD, my)
my = my + 22
c.lblFlightsCap = lbl("Flights:", PAD, my + 4, 70, CapSkin)
c.btnFlightsDown = btn("-", PAD + 76,  my, 40)
c.lblFlightsVal  = lbl("1", PAD + 122, my + 4, 36, ValueSkin)
c.btnFlightsUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnMarshalBroadcast = btn("Broadcast Marshal Stack", PAD, my, 250)

my = my + BTN_H + PAD*2
c.lblMarCharlie = lbl("CHARLIE / PUSH", PAD, my)
my = my + 22
c.lblCharlieCap = lbl("Minutes:", PAD, my + 4, 70, CapSkin)
c.btnCharlieDown = btn("-", PAD + 76,  my, 40)
c.lblCharlieVal  = lbl("15", PAD + 122, my + 4, 36, ValueSkin)
c.btnCharlieUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnCharlieBroadcast = btn("Broadcast Charlie", PAD, my, 250)

-- ============================================================== MARSHALL TAB ==
-- v1.3-beta7: 60nm CCZ scatter view (replaces beta5's text list) + radio
-- readout below.  Scatter area is x=20..520, y=50..330 with the carrier dot
-- at centre (270, 190).  Range scale: 60 nm = ~140 px.  Hook positions the
-- modex slot pool (rowCcz1..12 re-purposed as scatter slots) every poll.

c.lblMarshallHdr   = lbl("CCZ TRACKER  ·  60 nm  (N = up)",         PAD,  30, W - PAD*2, LabelSkin, 20)

-- Range scale ticks at compass cardinal positions around carrier centre
c.lblCczN60        = lbl("60",                                       263,  52, 20, RadarLbl, 12)
c.lblCczN30        = lbl("30",                                       263, 120, 20, RadarLbl, 12)
c.lblCczS30        = lbl("30",                                       263, 252, 20, RadarLbl, 12)
c.lblCczS60        = lbl("60",                                       263, 320, 20, RadarLbl, 12)
c.lblCczW60        = lbl("60",                                       126, 184, 20, RadarLbl, 12)
c.lblCczE60        = lbl("60",                                       408, 184, 20, RadarLbl, 12)
c.lblCczCv         = lbl("CV",                                       265, 184, 30, CarrierMark, 16)
-- Aircraft scatter slots — hook positions each by (brg, nm) every poll.
-- Initial position off-screen; setBounds() moves visible ones into the
-- 540×300 scatter area whose centre is at (270, 190).
for i = 1, 12 do
    c["rowCcz" .. i] = lbl("", -200, -200, 40, SpotSkin, 16)
end

-- Radio readout below the scatter view.
c.lblMarRadioHdr   = lbl("RADIO READOUT",                            PAD, 360, W - PAD*2, LabelSkin, 20)
c.lblMarRadioBase  = lbl("ALT --.--   BRC ---°   CASE -",            PAD, 384, W - PAD*2, ValueSkin, 20)
c.lblMarRadioCols  = lbl("  MODEX   BRA          ALT     ASSIGN  EAT", PAD, 410, W - PAD*2, CapSkin, 16)
for i = 1, 12 do
    c["rowMarCall" .. i] = lbl("", PAD, 430 + (i-1)*16, W - PAD*2, RowSkinMon, 16)
end
c.lblMarStatus     = lbl("(waiting for inbound traffic...)",           PAD, 630, W - PAD*2, CapSkin, 18)

-- ============================================================= DECKBOSS TAB ==
-- v1.3-beta7: rotated so BOW = top, STERN = bottom, PORT = left, STBD = right
-- (standard top-down view).  The deck silhouette is painted with box-drawing
-- character widgets at port/stbd/bow/stern edges — dxgui has no line/rect
-- primitives so each character is its own Static widget.  Zone labels sit
-- inside the silhouette; modex slot pool gets repositioned by the hook from
-- carriergui_deck.txt every poll.

c.lblDbHdr      = lbl("DECK VIEW  ·  BOW = top  ·  PORT = left",  PAD, 30, W - PAD*2, LabelSkin, 18)

-- Box-drawing outline.  Each `──` or `│` is one Static widget.
-- Bow horizontal edge (y=55, x=140..390 every 30px = 9 cells of "──")
local OutlineSkin = mkLabelSkin("0x6080a0ff", 16)
c.lblDbBowH1    = lbl("──", 140,  55, 30, OutlineSkin, 16)
c.lblDbBowH2    = lbl("──", 170,  55, 30, OutlineSkin, 16)
c.lblDbBowH3    = lbl("──", 200,  55, 30, OutlineSkin, 16)
c.lblDbBowH4    = lbl("──", 230,  55, 30, OutlineSkin, 16)
c.lblDbBowH5    = lbl("──", 260,  55, 30, OutlineSkin, 16)
c.lblDbBowH6    = lbl("──", 290,  55, 30, OutlineSkin, 16)
