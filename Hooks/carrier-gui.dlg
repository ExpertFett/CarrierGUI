-- v1.3-beta14: rotated so BOW = top, STERN = bottom, PORT = left, STBD = right
-- (standard top-down view).  The deck silhouette is painted with box-drawing
-- character widgets at port/stbd/bow/stern edges — dxgui has no line/rect
-- primitives so each character is its own Static widget.  Zone labels sit
-- inside the silhouette; modex slot pool gets repositioned by the hook from
-- carriergui_deck.txt every poll.

c.lblDbHdr      = lbl("DECK VIEW  ·  BOW = top  ·  PORT = left",  PAD, 30, W - PAD*2, LabelSkin, 18)

-- ── deck silhouette — HORIZONTAL: BOW = right, PORT = top ────────────────
-- Deck plate x=60..480 (420 long), y=120..240 (120 wide).
c.dbDeck    = solidW( 60, 120, 420, 120, DECK_FILL_SKIN, 1)
-- angled landing-area strip (rises to port/top toward the bow)
do
    local strip = solidW( 75, 161, 270,  48, DECK_STRP_SKIN, 2)
    strip.params.angle = -10
    strip.params.pivotPoint = { ["x"] = 135, ["y"] = 24 }
    c.dbStrip = strip
end
-- deck edge lines
c.dbEdgeT   = solidW( 60, 120, 420,   2, DECK_EDGE_SKIN, 3)
c.dbEdgeB   = solidW( 60, 238, 420,   2, DECK_EDGE_SKIN, 3)
c.dbEdgeL   = solidW( 60, 120,   2, 120, DECK_EDGE_SKIN, 3)
c.dbEdgeR   = solidW(478, 120,   2, 120, DECK_EDGE_SKIN, 3)
-- catapult tracks: 1+2 at the bow (right end), 3+4 angled on the waist
c.dbCat1    = solidW(390, 148,  76,   3, CAT_SKIN, 3)
c.dbCat2    = solidW(390, 184,  76,   3, CAT_SKIN, 3)
do
    local c3 = solidW(160, 172,  76,   3, CAT_SKIN, 3)
    c3.params.angle = -10
    c3.params.pivotPoint = { ["x"] = 38, ["y"] = 1 }
    c.dbCat3 = c3
    local c4 = solidW(160, 202,  76,   3, CAT_SKIN, 3)
    c4.params.angle = -10
    c4.params.pivotPoint = { ["x"] = 38, ["y"] = 1 }
    c.dbCat4 = c4
end
-- island on the starboard (bottom) edge + the four elevators
c.dbIslandF = solidW(290, 224,  64,  14, ISLAND_SKIN, 2)
c.dbEl1     = solidW(368, 230,  30,  10, ELEV_SKIN, 2)
c.dbEl2     = solidW(240, 230,  30,  10, ELEV_SKIN, 2)
c.dbEl3     = solidW(150, 122,  30,  10, ELEV_SKIN, 2)
c.dbEl4     = solidW( 90, 230,  30,  10, ELEV_SKIN, 2)

-- Deck zone labels — horizontal silhouette (BOW right, PORT top)
c.lblDbBow      = lbl("BOW",        484, 172, 40, DeckSkin, 14)
c.lblDbStern    = lbl("STERN",       14, 172, 50, DeckSkin, 14)
c.lblDbCat1     = lbl("CAT1",       392, 132, 44, DeckHdr,  13)
c.lblDbCat2     = lbl("CAT2",       392, 192, 44, DeckHdr,  13)
c.lblDbCat3     = lbl("CAT3",       150, 156, 44, DeckHdr,  13)
c.lblDbCat4     = lbl("CAT4",       150, 208, 44, DeckHdr,  13)
c.lblDbIsland   = lbl("ISLAND",     300, 246, 50, DeckSkin, 12)
c.lblDb6pk      = lbl("6-PACK",     330, 128, 60, DeckSkin, 12)
c.lblDbWaist    = lbl("WAIST",      230, 146, 60, DeckSkin, 12)
c.lblDbElev1    = lbl("EL1",        372, 246, 30, DeckSkin, 11)
c.lblDbElev2    = lbl("EL2",        244, 246, 30, DeckSkin, 11)
c.lblDbElev3    = lbl("EL3",        154, 106, 30, DeckSkin, 11)
c.lblDbElev4    = lbl("EL4",         94, 246, 30, DeckSkin, 11)
c.lblDbJunk     = lbl("JUNKYARD",    70, 128, 80, DeckHdr,  12)

-- Aircraft modex slot pool — hook moves visible ones into position.
for i = 1, 16 do
    c["spotDb" .. i] = lbl("", -200, -200, 50, SpotSkin, 14)
end

-- ON DECK summary list (one line per aircraft, below the deck silhouette).
c.lblDbOnDeckHdr  = lbl("ON DECK",                                  PAD, 280, W - PAD*2, LabelSkin, 18)
c.lblDbOnDeckCols = lbl("  MODEX     ALONG       ACROSS     ZONE",  PAD, 300, W - PAD*2, CapSkin,   14)
for i = 1, 10 do
    c["rowDbOnDeck" .. i] = lbl("", PAD, 318 + (i-1)*15, W - PAD*2, RowSkinMon, 15)
end

-- Conga toggle (state label only; path overlay deferred).
c.lblDbCongaState = lbl("CONGA LINE:  OFF", PAD,        490, 200, ValueSkin, 20)
c.btnDbConga      = btn("TOGGLE CONGA",     PAD + 220,  490, 150)
c.lblDbCongaHint  = lbl("(path overlay disabled in beta — preview only)",
                        PAD, 518, W - PAD*2, CapSkin, 16)

-- ================================================================= LSO TAB ==
-- v1.3: rebuilt.  Layout top → bottom:
--   1. CASE I PATTERN  — list view, one row per pattern point (INITIAL,
--      BREAK, DOWNWIND, ABEAM, 180, GROOVE, TRAP).  Each row shows the
--      modex/alt/spd of whoever the bridge classified at that point.
--   2. LSO LIGHTS      — big WAVE OFF (red) + CUT (green) buttons.  They
--      latch lit for ~5s after press (hook-side state + setSkin swap).
--   3. PLAT CAMERA     — existing NVG bar + RESET CAM (text-block style).
--      Wire/Deck/Zoom buttons RETIRED in v1.3 (didn't do what we hoped
--      in-game).  Bingo/RecovOK also retired — kept on hook side as
--      F10 calls instead.
--   4. SHIP            — live HDG / wind from bridge.
--   5. RECOVERY EVENTS — last 3 LSO prompts (CASE III monitor still wired).

-- ── CASE I PATTERN ──────────────────────────────────────────
-- v1.3-beta14: racetrack visual.  Landmark labels at fixed pattern points,
-- carrier marker at the trap position, aircraft slot pool the hook moves
-- to each plane's current point.  90° corners at BREAK and at 90→groove.
c.lblPatHdr      = lbl("CASE I OVERHEAD  ·  port racetrack",  PAD,  30, W - PAD*2, LabelSkin, 18)

-- ── scope face + racetrack drawn with solid lines + corner arcs ──────────
-- Track: right leg x=400 (INITIAL up to BREAK), top leg y=55 (BREAK to the
-- downwind turn), left leg x=140 (DOWNWIND/ABEAM/180), bottom leg y=260
-- (180 to the 90).  90° corners on the right (per user feedback), rounded
-- arcs on the left turns.
c.pScope   = solidW( 14,  46, 512, 234, SCOPE_BG_SKIN, 1)
c.pBordT   = solidW( 14,  46, 512,   1, SCOPE_RG_SKIN, 3)
c.pBordB   = solidW( 14, 279, 512,   1, SCOPE_RG_SKIN, 3)
c.pBordL   = solidW( 14,  46,   1, 234, SCOPE_RG_SKIN, 3)
c.pBordR   = solidW(525,  46,   1, 234, SCOPE_RG_SKIN, 3)
-- racetrack legs — HORIZONTAL layout (uses the full panel width).
-- Flow: INITIAL enters bottom-left, upwind to the ship at bottom-right,
-- 90° BREAK up the right side, 90° onto the downwind (top leg, right→left),
-- rounded 180 turn on the left, back to the GROOVE and the TRAP.
c.pLegB    = solidW(120, 219, 350,   2, SCOPE_RG_SKIN, 3)
c.pLegR    = solidW(468,  90,   2, 131, SCOPE_RG_SKIN, 3)
c.pLegT    = solidW(120,  89, 350,   2, SCOPE_RG_SKIN, 3)
-- rounded 180 turn on the left (semicircle, generated)

-- own ship on the bottom leg (trap end)
c.pShip    = solidW(424, 209,  22,  12, SHIP_MARK_SKIN, 3)

-- Pattern landmark labels (sit just off the drawn track)
c.lblPatInitial  = lbl("INITIAL",   110, 230, 70, DeckSkin, 14)
c.lblPatBreak    = lbl("BREAK",     478, 148, 60, DeckSkin, 14)
c.lblPatDwnwd    = lbl("DOWNWIND",  240,  68, 80, DeckSkin, 14)
c.lblPatAbeam    = lbl("ABEAM",     408,  68, 60, DeckSkin, 14)
c.lblPat180      = lbl("180",        38, 148, 40, DeckSkin, 14)
c.lblPat90       = lbl("90",         88, 238, 30, DeckSkin, 14)
c.lblPatGroove   = lbl("GROOVE",    320, 230, 70, DeckSkin, 14)
c.lblPatTrap     = lbl("TRAP",      424, 192, 50, DeckHdr,  14)
c.lblPatCv       = lbl("CV",        450, 230, 30, CarrierMark, 14)

-- Aircraft slot pool — 8 modex labels the hook moves to whichever pattern
-- point the bridge classified them at.
for i = 1, 8 do
    c["acftPat" .. i] = lbl("", -200, -200, 40, SpotSkin, 14)
end

-- ── LSO LIGHTS ─────────────────────────────────────────────
c.lblLightsHdr = lbl("LSO LIGHTS",                              PAD, 295, W - PAD*2, LabelSkin, 18)
c.btnWaveOff   = btn("WAVE OFF",  PAD,           320, 250)
c.btnCut       = btn("CUT",       PAD + 256,     320, 250)
c.btnWaveOff.params.bounds.h = 60
c.btnCut.params.bounds.h     = 60

-- ── PLAT CAMERA  (NVG + RESET CAM kept; Wire/Deck/Zoom RETIRED) ──
c.lblLsoNvg   = lbl("PLAT NVG GAIN",                            PAD,  395, 240, LabelSkin, 18)
c.btnResetCam = btn("RESET CAM",                    W - PAD - 110,  395, 110)

