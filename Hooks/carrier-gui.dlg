-- CarrierGUI dialog layout  (v1.0-beta3 — three tabs: CARRIER + MARSHALL + LSO)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.

local W = 380       -- window width
local H = 560       -- window height
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = size or 14,
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = BTN_H, ["w"] = w or BTN_W, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = h or 18, ["w"] = w or 200, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]  = { ["h"] = H, ["w"] = W, ["x"] = 200, ["y"] = 100 },
        ["enabled"] = true,
        ["text"]    = "Carrier Control",
        ["tooltip"] = "",
        ["visible"] = false,            -- hook flips to true after creation
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- ---------------------------------------------------------------- TAB BAR ---
-- Three tabs across the top — slightly narrower to fit within 380 px window.
c.btnTabCarrier  = btn("CARRIER",  PAD,        4, 118)
c.btnTabMarshall = btn("MARSHALL", PAD + 124,  4, 118)
c.btnTabLso      = btn("LSO",      PAD + 248,  4, 118)

-- =============================================================== CARRIER TAB ==
local y = 40
c.lblLights         = lbl("LIGHTS", PAD, y)
y = y + 22
c.btnLightsOff      = btn("Off",      PAD + (BTN_W+PAD)*0, y)
c.btnLightsAuto     = btn("Auto",     PAD + (BTN_W+PAD)*1, y)
c.btnLightsNav      = btn("Nav",      PAD + (BTN_W+PAD)*2, y)
c.btnLightsLaunch   = btn("Launch",   PAD + (BTN_W+PAD)*3, y)
y = y + BTN_H + PAD
c.btnLightsRecovery = btn("Recovery", PAD, y, BTN_W*2 + PAD)

y = y + BTN_H + PAD*2
c.lblTacan          = lbl("TACAN", PAD, y)
y = y + 22
c.btnTacanOn        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnTacanOff       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblIcls           = lbl("ICLS", PAD, y)
y = y + 22
c.btnIclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnIclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblLink4          = lbl("LINK 4", PAD, y)
y = y + 22
c.btnLink4On        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnLink4Off       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblAcls           = lbl("ACLS", PAD, y)
y = y + 22
c.btnAclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnAclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblWind           = lbl("TURN INTO WIND", PAD, y, 250)
y = y + 22
local wb = 48
c.btnWindStop = btn("Stop", PAD + (wb+4)*0, y, wb)
c.btnWind30m  = btn("30m",  PAD + (wb+4)*1, y, wb)
c.btnWind60m  = btn("60m",  PAD + (wb+4)*2, y, wb)
c.btnWind90m  = btn("90m",  PAD + (wb+4)*3, y, wb)
c.btnWind2h   = btn("2h",   PAD + (wb+4)*4, y, wb)
c.btnWind4h   = btn("4h",   PAD + (wb+4)*5, y, wb)
c.btnWind8h   = btn("8h",   PAD + (wb+4)*6, y, wb)

-- ============================================================== MARSHALL TAB ==
-- Marshall widgets overlap the carrier widgets in Y; only one tab is visible
-- at a time (hook toggles). All start visible; hook hides the inactive tab.
local my = 40
c.lblMarCase = lbl("RECOVERY CASE", PAD, my)
my = my + 22
c.btnCase1 = btn("CASE I",   PAD + (114+PAD)*0, my, 114)
c.btnCase2 = btn("CASE II",  PAD + (114+PAD)*1, my, 114)
c.btnCase3 = btn("CASE III", PAD + (114+PAD)*2 - 116, my + 0, 114)
-- third button on next position; keep 3 across if width allows, else wrap
c.btnCase3.params.bounds.x = PAD + (114+PAD)*2
my = my + BTN_H + PAD*2

c.lblMarStack = lbl("MARSHAL STACK", PAD, my)
my = my + 22
c.lblFlightsCap = lbl("Flights:", PAD, my + 4, 70, CapSkin)
c.btnFlightsDown = btn("-", PAD + 76,  my, 40)
c.lblFlightsVal  = lbl("1", PAD + 122, my + 4, 36, ValueSkin)
c.btnFlightsUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnMarshalBroadcast = btn("Broadcast Marshal Stack", PAD, my, 250)

my = my + BTN_H + PAD*2
c.lblMarCharlie = lbl("CHARLIE / PUSH", PAD, my)
my = my + 22
c.lblCharlieCap = lbl("Minutes:", PAD, my + 4, 70, CapSkin)
c.btnCharlieDown = btn("-", PAD + 76,  my, 40)
c.lblCharlieVal  = lbl("15", PAD + 122, my + 4, 36, ValueSkin)
c.btnCharlieUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnCharlieBroadcast = btn("Broadcast Charlie", PAD, my, 250)

-- ================================================================= LSO TAB ==
-- v1.0: PLAT-cam NVG GAIN DIAL — graphical half-dial. Layout from back to
-- front (defined in this order so z-stacking is correct):
--   1) dialFace        — 280x160 PNG, the actual dial bezel + ticks
--   2) 11 number labels around the rim (outside the bezel)
--   3) dialPip         — small bright "●" character; hook moves it to the
--                        current gain position on each update
-- Big "OFF"/"NN%" readout BELOW the dial; help/status below that.
-- Pre-computed literal coords (DialogLoader's sandbox blocks math.* loops).
c.lblLsoNvg = lbl("PLAT-CAM NVG GAIN", PAD, 38, 240, LabelSkin, 18)

-- Dial face image. .dlg has no working picture path (relative paths don't
-- resolve cleanly), so we leave the skin empty — the hook builds a skin
-- with picture.file = lfs.writedir() ..'Scripts/Hooks/assets/dial-face.png'
-- and applies it via setSkin at createWindow.
-- Image is 280x160; dial centre at image (140, 150). Placed at window (50,70)
-- so dial centre = window (190, 220).
c.dialFace = {
    ["params"] = {
        ["bounds"]  = { ["h"] = 160, ["w"] = 280, ["x"] = 50, ["y"] = 70 },
        ["enabled"] = true,
        ["text"]    = "",
        ["tooltip"] = "",
        ["visible"] = true,
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "staticSkin" } },
    ["type"] = "Static",
}

-- 11 number labels around the dial rim. Radius 160 from dial centre (190,220).
-- Numbers sit OUTSIDE the rim so the dial face shows through unobstructed.
-- Hook swaps colour LIT vs DIM via setSkin (selected gain = bright green).
local NumLit = mkLabelSkin("0x60ff80ff", 22)
c.dotNvg0  = lbl("0",     5, 206, 50, NumLit, 24)
c.dotNvg1  = lbl("10",   12, 157, 50, NumLit, 24)
c.dotNvg2  = lbl("20",   35, 112, 50, NumLit, 24)
c.dotNvg3  = lbl("30",   71,  76, 50, NumLit, 24)
c.dotNvg4  = lbl("40",  115,  54, 50, NumLit, 24)
c.dotNvg5  = lbl("50",  165,  46, 50, NumLit, 24)
c.dotNvg6  = lbl("60",  215,  54, 50, NumLit, 24)
c.dotNvg7  = lbl("70",  259,  76, 50, NumLit, 24)
c.dotNvg8  = lbl("80",  295, 112, 50, NumLit, 24)
c.dotNvg9  = lbl("90",  318, 157, 50, NumLit, 24)
c.dotNvg10 = lbl("100", 325, 206, 50, NumLit, 24)

-- Dial pip ("●") sitting on the dial face. The hook repositions this widget
-- each frame to point at the current gain. Initial position = 0% (left).
-- "\226\151\143" is decimal-escape U+25CF (●) — Lua 5.1 supports decimal
-- escapes; the v0.8 hex-escape bug doesn't apply here.
local PipSkin = mkLabelSkin("0xfffeb0ff", 24)
c.dialPip = lbl("\226\151\143", 67, 207, 24, PipSkin, 26)

-- Big centre readout — mouse-wheel target — BELOW the dial.
local BigSkin = mkLabelSkin("0xffffffff", 40)
c.lblNvgVal = lbl("OFF", 90, 240, 200, BigSkin, 50)

-- State + help below
c.lblNvgState = lbl("normal feed", PAD, 300, W - PAD*2, ValueSkin, 22)
c.lblLsoHelp  = lbl(
    "Scroll wheel over the centre readout to spin the gain.\n" ..
    "Or click any number to jump directly to that gain.",
    PAD, 330, W - PAD*2, CapSkin, 40)

-- ============================================================= SHARED STATUS ==
local StatusSkin = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = true },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xaaaaaaff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = 12,
                },
            },
        },
    },
}
c.lblStatus = {
    ["params"] = {
        ["bounds"]  = { ["h"] = 40, ["w"] = W - PAD*2, ["x"] = PAD, ["y"] = H - 50 },
        ["enabled"] = true,
        ["text"]    = "Bridge: checking...",
        ["tooltip"] = "",
        ["visible"] = true,
        ["zindex"]  = 0,
    },
    ["skin"] = StatusSkin,
    ["type"] = "Static",
}
