-- CarrierGUI dialog layout  (v1.3-beta1 — 5-tab skeleton)
-- Loaded by carrier-gui-hook.lua via DialogLoader.spawnDialogFromFile.
-- The hook wires each btn* child and toggles tab visibility.
--
-- v1.3 layout: 5 tabs across the top.
--   CARRIER   — F10 menu controls (lights, beacons, wind) — UNCHANGED in beta1
--   MARSHALL  — NEW. CCZ 60nm radar + radio readout (placeholder in beta1)
--   TOWER     — RENAMED from old MARSHALL. CASE / Charlie / stack broadcasts
--   LSO       — PLAT NVG + camera controls. UNCHANGED in beta1 (overhead
--               pattern + drop-of-Wire/Deck/Zoom arrives in beta4)
--   DECKBOSS  — NEW. Top-down deck view (placeholder in beta1)
--
-- Panel widened from 380→540 to make room for the radars in later betas.

local W = 540       -- window width  (was 380 in v1.2)
local H = 640       -- window height (extended in v1.2 for the RECOVERY EVENTS section)
local BTN_W = 72    -- standard button width
local BTN_H = 26    -- standard button height
local PAD = 6

local ButtonSkin = { ["params"] = { ["name"] = "buttonSkin" } }

local function mkLabelSkin(color, size)
    return {
        ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = false },
        ["states"] = {
            ["released"] = {
                [1] = {
                    ["text"] = {
                        ["color"]      = color or "0xfbb941ff",
                        ["font"]       = "DejaVuLGCSansCondensed-Bold.ttf",
                        ["lineHeight"] = size or 14,
                    },
                },
            },
        },
    }
end

local LabelSkin  = mkLabelSkin("0xfbb941ff", 14)   -- section headers (amber)
local ValueSkin  = mkLabelSkin("0xffffffff", 16)   -- stepper values (white)
local CapSkin    = mkLabelSkin("0xccccccff", 13)   -- captions (grey)

local function btn(text, x, y, w, skin)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = BTN_H, ["w"] = w or BTN_W, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or ButtonSkin,
        ["type"] = "Button",
    }
end

local function lbl(text, x, y, w, skin, h)
    return {
        ["params"] = {
            ["bounds"]  = { ["h"] = h or 18, ["w"] = w or 200, ["x"] = x, ["y"] = y },
            ["enabled"] = true,
            ["text"]    = text,
            ["tooltip"] = "",
            ["visible"] = true,
            ["zindex"]  = 0,
        },
        ["skin"] = skin or LabelSkin,
        ["type"] = "Static",
    }
end

dialog = {
    ["children"] = {},
    ["params"] = {
        ["bounds"]  = { ["h"] = H, ["w"] = W, ["x"] = 200, ["y"] = 100 },
        ["enabled"] = true,
        ["text"]    = "Carrier Control",
        ["tooltip"] = "",
        ["visible"] = false,            -- hook flips to true after creation
        ["zindex"]  = 0,
    },
    ["skin"] = { ["params"] = { ["name"] = "windowSkin" } },
    ["type"] = "Window",
}

local c = dialog.children

-- ---------------------------------------------------------------- TAB BAR ---
-- v1.3-beta1: 5 tabs across the top in a wider (540 px) window.
-- Each tab = 100 wide, 6 px gap. Total span: 5*100 + 4*6 = 524 < 540-PAD*2.
c.btnTabCarrier  = btn("CARRIER",  PAD + (100+6)*0, 4, 100)
c.btnTabMarshall = btn("MARSHALL", PAD + (100+6)*1, 4, 100)
c.btnTabTower    = btn("TOWER",    PAD + (100+6)*2, 4, 100)
c.btnTabLso      = btn("LSO",      PAD + (100+6)*3, 4, 100)
c.btnTabDeckboss = btn("DECKBOSS", PAD + (100+6)*4, 4, 100)

-- =============================================================== CARRIER TAB ==
local y = 40
c.lblLights         = lbl("LIGHTS", PAD, y)
y = y + 22
c.btnLightsOff      = btn("Off",      PAD + (BTN_W+PAD)*0, y)
c.btnLightsAuto     = btn("Auto",     PAD + (BTN_W+PAD)*1, y)
c.btnLightsNav      = btn("Nav",      PAD + (BTN_W+PAD)*2, y)
c.btnLightsLaunch   = btn("Launch",   PAD + (BTN_W+PAD)*3, y)
y = y + BTN_H + PAD
c.btnLightsRecovery = btn("Recovery", PAD, y, BTN_W*2 + PAD)

y = y + BTN_H + PAD*2
c.lblTacan          = lbl("TACAN", PAD, y)
y = y + 22
c.btnTacanOn        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnTacanOff       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblIcls           = lbl("ICLS", PAD, y)
y = y + 22
c.btnIclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnIclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblLink4          = lbl("LINK 4", PAD, y)
y = y + 22
c.btnLink4On        = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnLink4Off       = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblAcls           = lbl("ACLS", PAD, y)
y = y + 22
c.btnAclsOn         = btn("On",  PAD + (BTN_W+PAD)*0, y)
c.btnAclsOff        = btn("Off", PAD + (BTN_W+PAD)*1, y)

y = y + BTN_H + PAD*2
c.lblWind           = lbl("TURN INTO WIND", PAD, y, 250)
y = y + 22
local wb = 48
c.btnWindStop = btn("Stop", PAD + (wb+4)*0, y, wb)
c.btnWind30m  = btn("30m",  PAD + (wb+4)*1, y, wb)
c.btnWind60m  = btn("60m",  PAD + (wb+4)*2, y, wb)
c.btnWind90m  = btn("90m",  PAD + (wb+4)*3, y, wb)
c.btnWind2h   = btn("2h",   PAD + (wb+4)*4, y, wb)
c.btnWind4h   = btn("4h",   PAD + (wb+4)*5, y, wb)
c.btnWind8h   = btn("8h",   PAD + (wb+4)*6, y, wb)

-- ================================================================= TOWER TAB ==
-- v1.3-beta1: renamed from MARSHALL. Same widgets, same coords — only the tab
-- label changes. Widget names keep the "Mar*" prefix to avoid touching the
-- BUTTON_FLAGS table and the broadcast wiring (which still fires the same
-- numbered user flags the bridge listens for).
local my = 40
c.lblMarCase = lbl("RECOVERY CASE", PAD, my)
my = my + 22
c.btnCase1 = btn("CASE I",   PAD + (114+PAD)*0, my, 114)
c.btnCase2 = btn("CASE II",  PAD + (114+PAD)*1, my, 114)
c.btnCase3 = btn("CASE III", PAD + (114+PAD)*2 - 116, my + 0, 114)
-- third button on next position; keep 3 across if width allows, else wrap
c.btnCase3.params.bounds.x = PAD + (114+PAD)*2
my = my + BTN_H + PAD*2

c.lblMarStack = lbl("MARSHAL STACK", PAD, my)
my = my + 22
c.lblFlightsCap = lbl("Flights:", PAD, my + 4, 70, CapSkin)
c.btnFlightsDown = btn("-", PAD + 76,  my, 40)
c.lblFlightsVal  = lbl("1", PAD + 122, my + 4, 36, ValueSkin)
c.btnFlightsUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnMarshalBroadcast = btn("Broadcast Marshal Stack", PAD, my, 250)

my = my + BTN_H + PAD*2
c.lblMarCharlie = lbl("CHARLIE / PUSH", PAD, my)
my = my + 22
c.lblCharlieCap = lbl("Minutes:", PAD, my + 4, 70, CapSkin)
c.btnCharlieDown = btn("-", PAD + 76,  my, 40)
c.lblCharlieVal  = lbl("15", PAD + 122, my + 4, 36, ValueSkin)
c.btnCharlieUp   = btn("+", PAD + 162, my, 40)
my = my + BTN_H + PAD
c.btnCharlieBroadcast = btn("Broadcast Charlie", PAD, my, 250)

-- ============================================================== MARSHALL TAB ==
-- v1.3-beta1: placeholder only. Full content lands in v1.3-beta3:
--   60nm overhead radar (CCZ) + marshal radio readout (altimeter, BRC,
--   per-modex BRA + ANGELS + EAT).
local SubSkin = mkLabelSkin("0xccccccff", 16)
c.lblMarshallHdr  = lbl("MARSHALL  ·  CCZ TRACKER",                  PAD, 80,  W - PAD*2, LabelSkin, 22)
c.lblMarshallSub1 = lbl("Coming in v1.3-beta3.",                      PAD, 112, W - PAD*2, SubSkin,   20)
c.lblMarshallSub2 = lbl("60nm overhead radar  +  marshal radio call.", PAD, 134, W - PAD*2, SubSkin,   20)
c.lblMarshallSub3 = lbl("Bridge will enumerate friendlies <60nm and",  PAD, 162, W - PAD*2, CapSkin,   18)
c.lblMarshallSub4 = lbl("write modex / BRA / alt to the IPC channel.", PAD, 180, W - PAD*2, CapSkin,   18)

-- ============================================================= DECKBOSS TAB ==
-- v1.3-beta1: placeholder only. Full content lands in v1.3-beta5:
--   Top-down deck silhouette + modex positions + conga-line overlay toggle.
--   View-only — no game-state writes.
c.lblDeckbossHdr  = lbl("DECKBOSS  ·  DECK VIEW",                    PAD, 80,  W - PAD*2, LabelSkin, 22)
c.lblDeckbossSub1 = lbl("Coming in v1.3-beta5.",                      PAD, 112, W - PAD*2, SubSkin,   20)
c.lblDeckbossSub2 = lbl("Top-down deck silhouette  +  modex layout.", PAD, 134, W - PAD*2, SubSkin,   20)
c.lblDeckbossSub3 = lbl("Toggle for conga-line taxi-path overlay.",   PAD, 162, W - PAD*2, CapSkin,   18)
c.lblDeckbossSub4 = lbl("View only  ·  no game-state writes.",        PAD, 180, W - PAD*2, CapSkin,   18)

-- ================================================================= LSO TAB ==
-- v1.0-beta4: scrapped the image dial — DCS's dxgui picture loader silently
-- rejects every alpha-bearing format we tried (PNG, BMP V4, TGA). Falling
-- back to a clean all-text LED bar gauge using only proven primitives:
-- Static widgets, text colour skins, click + scroll-wheel callbacks.
--
-- Layout:
--   y= 38   "PLAT-CAM NVG GAIN" header
--   y= 78   big OFF/% readout (font 48) — also the mouse-wheel target
--   y=170   row of 10 LED segments, each lit IFF gain >= (i+1)*10
--   y=215   tick labels "0%" / "50%" / "100%" under the bar
--   y=250   state line
--   y=280   help

-- LSO tab is dense. Sections top→bottom:
--   PLAT NVG gain bar (existing v1.0-beta5)
--   WIRE TARGET   — 1/2/3/4 buttons → setDesiredRope
--   DECK STATUS   — FOUL/CLEAR     → setFoulDeck + broadcast
--   PLAT ZOOM     — -/+ stepper    → adjustGate (PLAT FOV)
--   LSO CALLS     — WAVE OFF / CUT / BINGO / RECOVERY broadcasts
--   SHIP STATUS   — live HDG / wind readout (bridge → file → hook)

c.lblLsoNvg = lbl("PLAT NVG GAIN", PAD, 36, 240, LabelSkin, 18)

-- Panic button: one-click revert to vanilla DCS PLAT cam.
-- NVG -> 0%, zoom -> DCS default (no override). Foul/wire untouched.
c.btnResetCam = btn("RESET CAM", W - PAD - 110, 36, 110)

local BigSkin = mkLabelSkin("0xffffffff", 36)
c.lblNvgVal   = lbl("OFF", 110, 58, 160, BigSkin, 48)

local LedFull = mkLabelSkin("0x60ff80ff", 28)
local BLK = "\226\150\136"   -- "█" U+2588 via decimal escape
c.ledNvg1  = lbl(BLK,  41, 112, 28, LedFull, 36)   -- 10%
c.ledNvg2  = lbl(BLK,  71, 112, 28, LedFull, 36)   -- 20%
c.ledNvg3  = lbl(BLK, 101, 112, 28, LedFull, 36)   -- 30%
c.ledNvg4  = lbl(BLK, 131, 112, 28, LedFull, 36)   -- 40%
c.ledNvg5  = lbl(BLK, 161, 112, 28, LedFull, 36)   -- 50%
c.ledNvg6  = lbl(BLK, 191, 112, 28, LedFull, 36)   -- 60%
c.ledNvg7  = lbl(BLK, 221, 112, 28, LedFull, 36)   -- 70%
c.ledNvg8  = lbl(BLK, 251, 112, 28, LedFull, 36)   -- 80%
c.ledNvg9  = lbl(BLK, 281, 112, 28, LedFull, 36)   -- 90%
c.ledNvg10 = lbl(BLK, 311, 112, 28, LedFull, 36)   -- 100%

local TickSkin = mkLabelSkin("0xa0a0a0ff", 12)
c.lblTick0   = lbl("0%",     35, 152, 40, TickSkin, 14)
c.lblTick50  = lbl("50%",   165, 152, 40, TickSkin, 14)
c.lblTick100 = lbl("100%",  305, 152, 50, TickSkin, 14)

-- ── WIRE TARGET ──────────────────────────────────────────
c.lblWireHdr = lbl("WIRE TARGET", PAD, 175, 240, LabelSkin, 18)
c.btnWire1   = btn("1", PAD + (78+6)*0, 198, 78)
c.btnWire2   = btn("2", PAD + (78+6)*1, 198, 78)
c.btnWire3   = btn("3", PAD + (78+6)*2, 198, 78)
c.btnWire4   = btn("4", PAD + (78+6)*3, 198, 78)

-- ── DECK STATUS ──────────────────────────────────────────
c.lblDeckHdr = lbl("DECK STATUS", PAD, 235, 240, LabelSkin, 18)
c.btnFoulDeck  = btn("FOUL DECK",  PAD,        258, 175)
c.btnClearDeck = btn("CLEAR DECK", PAD + 181,  258, 175)

-- ── PLAT ZOOM ────────────────────────────────────────────
c.lblZoomHdr = lbl("PLAT ZOOM", PAD, 295, 240, LabelSkin, 18)
local ZoomCap = mkLabelSkin("0xccccccff", 13)
c.lblZoomCap = lbl("FOV:", PAD, 322, 70, ZoomCap, 18)
c.btnZoomDown = btn("-", PAD + 76,  318, 40)
local ZoomVal = mkLabelSkin("0xffffffff", 16)
c.lblZoomVal  = lbl("WIDE", PAD + 122, 322, 80, ZoomVal, 18)
c.btnZoomUp   = btn("+", PAD + 210, 318, 40)

-- ── LSO CALLS ────────────────────────────────────────────
c.lblCallsHdr = lbl("LSO CALLS", PAD, 355, 240, LabelSkin, 18)
c.btnWaveOff  = btn("WAVE OFF",     PAD,        378, 175)
c.btnCut      = btn("CUT",          PAD + 181,  378, 175)
c.btnBingo    = btn("BINGO TANKER", PAD,        414, 175)
c.btnRecComp  = btn("RECOVERY OK",  PAD + 181,  414, 175)

-- ── SHIP STATUS (live readout from the bridge) ────────────
c.lblShipHdr  = lbl("SHIP",   PAD, 455, 240, LabelSkin, 18)
c.lblShipHdg  = lbl("HDG: --",                PAD,        478, 170, ValueSkin, 20)
c.lblShipWind = lbl("Wind: --/-- kts",        PAD + 181,  478, 200, ValueSkin, 20)

-- ── RECOVERY EVENTS — LSO prompt log (3 most recent lines) ─────────
-- Bridge appends to carriergui_lso_events.txt as inbound aircraft cross
-- CASE III milestones (10 / 6 / 3 / 0.75 nm). Hook tails the file.
c.lblEventsHdr = lbl("RECOVERY EVENTS", PAD, 515, 240, LabelSkin, 18)
local EventSkin = mkLabelSkin("0xeaeaeaff", 14)
c.lblEvent1 = lbl("(waiting for inbound aircraft...)", PAD, 540, W - PAD*2, EventSkin, 18)
c.lblEvent2 = lbl("",                                    PAD, 562, W - PAD*2, EventSkin, 18)
c.lblEvent3 = lbl("",                                    PAD, 584, W - PAD*2, EventSkin, 18)

c.lblNvgState = lbl("Bridge: probing...", PAD, 612, W - PAD*2, CapSkin, 18)

-- ============================================================= SHARED STATUS ==
local StatusSkin = {
    ["params"] = { ["name"] = "staticSkin", ["textWrapping"] = true },
    ["states"] = {
        ["released"] = {
            [1] = {
                ["text"] = {
                    ["color"]      = "0xaaaaaaff",
                    ["font"]       = "DejaVuLGCSansCondensed.ttf",
                    ["lineHeight"] = 12,
                },
            },
        },
    },
}
c.lblStatus = {
    ["params"] = {
        ["bounds"]  = { ["h"] = 40, ["w"] = W - PAD*2, ["x"] = PAD, ["y"] = H - 50 },
        ["enabled"] = true,
        ["text"]    = "Bridge: checking...",
        ["tooltip"] = "",
        ["visible"] = true,
        ["zindex"]  = 0,
    },
    ["skin"] = StatusSkin,
    ["type"] = "Static",
}
