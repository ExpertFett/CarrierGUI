-- Conga toggle (state label only; path overlay deferred).
c.lblDbCongaState = lbl("CONGA LINE:  OFF", PAD,        600, 200, ValueSkin, 20)
c.btnDbConga      = btn("TOGGLE CONGA",     PAD + 220,  600, 150)
