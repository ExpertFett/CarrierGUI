c.lblShipHdg  = lbl("HDG: --",                PAD,        572, 170, ValueSkin, 20)
c.lblShipWind = lbl("Wind: --/-- kts",        PAD + 181,  572, 350, ValueSkin, 20)

-- ── RECOVERY EVENTS — LSO prompt log (3 most recent lines) ─────────
c.lblEventsHdr = lbl("RECOVERY EVENTS",                  PAD, 610, 240, LabelSkin, 18)
local EventSkin = mkLabelSkin("0xeaeaeaff", 14)
c.lblEvent1 = lbl("(waiting for inbound aircraft...)",   PAD, 635, W - PAD*2, EventSkin, 18)
c.lblEvent2 = lbl("",                                    PAD, 657, W - PAD*2, EventSkin, 18)
c.lblEvent3 = lbl("",                                    PAD, 679, W - PAD*2, EventSkin, 18)

c.lblNvgState = lbl("Bridge: probing...",                PAD, 715, W - PAD*2, CapSkin, 18)

