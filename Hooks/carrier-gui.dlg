-- ================================================================= LSO TAB ==
-- v1.3: rebuilt.  Layout top → bottom:
--   1. CASE I PATTERN  — list view, one row per pattern point (INITIAL,
--      BREAK, DOWNWIND, ABEAM, 180, GROOVE, TRAP).  Each row shows the
--      modex/alt/spd of whoever the bridge classified at that point.
--   2. LSO LIGHTS      — big WAVE OFF (red) + CUT (green) buttons.  They
--      latch lit for ~5s after press (hook-side state + setSkin swap).
--   3. PLAT CAMERA     — existing NVG bar + RESET CAM (text-block style).
--      Wire/Deck/Zoom buttons RETIRED in v1.3 (didn't do what we hoped
--      in-game).  Bingo/RecovOK also retired — kept on hook side as
--      F10 calls instead.
--   4. SHIP            — live HDG / wind from bridge.
--   5. RECOVERY EVENTS — last 3 LSO prompts (CASE III monitor still wired).

-- ── CASE I PATTERN ──────────────────────────────────────────
-- v1.3-beta21: racetrack visual.  Landmark labels at fixed pattern points,
-- carrier marker at the trap position, aircraft slot pool the hook moves
-- to each plane's current point.  90° corners at BREAK and at 90→groove.
c.lblPatHdr      = lbl("CASE I OVERHEAD  ·  port racetrack",  PAD,  30, W - PAD*2, LabelSkin, 18)

-- ── scope face + racetrack drawn with solid lines + corner arcs ──────────
-- Track: right leg x=400 (INITIAL up to BREAK), top leg y=55 (BREAK to the
-- downwind turn), left leg x=140 (DOWNWIND/ABEAM/180), bottom leg y=260
-- (180 to the 90).  90° corners on the right (per user feedback), rounded
-- arcs on the left turns.
c.pScope   = solidW( 14,  46, 512, 234, SCOPE_BG_SKIN, 1)
c.pBordT   = solidW( 14,  46, 512,   1, SCOPE_RG_SKIN, 3)
c.pBordB   = solidW( 14, 279, 512,   1, SCOPE_RG_SKIN, 3)
c.pBordL   = solidW( 14,  46,   1, 234, SCOPE_RG_SKIN, 3)
c.pBordR   = solidW(525,  46,   1, 234, SCOPE_RG_SKIN, 3)
-- racetrack legs — HORIZONTAL layout (uses the full panel width).
-- Flow: INITIAL enters bottom-left, upwind to the ship at bottom-right,
-- 90° BREAK up the right side, 90° onto the downwind (top leg, right→left),
-- rounded 180 turn on the left, back to the GROOVE and the TRAP.
c.pLegB    = solidW(120, 219, 350,   2, SCOPE_RG_SKIN, 3)
c.pLegR    = solidW(468,  90,   2, 131, SCOPE_RG_SKIN, 3)
c.pLegT    = solidW(120,  89, 350,   2, SCOPE_RG_SKIN, 3)
-- rounded 180 turn on the left (semicircle, generated)

-- own ship on the bottom leg (trap end)
c.pShip    = solidW(424, 209,  22,  12, SHIP_MARK_SKIN, 3)

-- Pattern landmark labels (sit just off the drawn track)
c.lblPatInitial  = lbl("INITIAL",   110, 230, 70, DeckSkin, 14)
c.lblPatBreak    = lbl("BREAK",     478, 148, 60, DeckSkin, 14)
c.lblPatDwnwd    = lbl("DOWNWIND",  240,  68, 80, DeckSkin, 14)
c.lblPatAbeam    = lbl("ABEAM",     408,  68, 60, DeckSkin, 14)
c.lblPat180      = lbl("180",        38, 148, 40, DeckSkin, 14)
c.lblPat90       = lbl("90",         88, 238, 30, DeckSkin, 14)
c.lblPatGroove   = lbl("GROOVE",    320, 230, 70, DeckSkin, 14)
c.lblPatTrap     = lbl("TRAP",      424, 192, 50, DeckHdr,  14)
c.lblPatCv       = lbl("CV",        450, 230, 30, CarrierMark, 14)

-- Aircraft slot pool — 8 modex labels the hook moves to whichever pattern
-- point the bridge classified them at.
for i = 1, 8 do
    c["acftPat" .. i] = lbl("", -200, -200, 40, SpotSkin, 14)
end

