-- smooth-ring IMAGE overlay (z=3, above dots).  Starts transparent;
-- the hook swaps in radar_scope.tga via setSkin.  If the image loads,
-- its solid rings cover the dots; if not, the dots remain visible.
c.mScopeImg = solidW(16, 54, 508, 304, TRANSPARENT_SKIN, 3)

-- own-ship marker (neutral square) + BRC heading vector dots.
-- The scope is north-up; the heading vector (hook-positioned dots from
-- centre outward along the ship BRC) shows which way the boat points,
-- and rotates as the heading changes.
c.mShip = solidW(266, 202, 8, 8, SHIP_MARK_SKIN, 4)
c.lblMRcv = lbl("CV", 278, 204, 30, CarrierMark, 14)
for i = 1, 7 do
    c["hdgDot" .. i] = solidW(-300, -300, 4, 4, SHIP_MARK_SKIN, 4)
end
