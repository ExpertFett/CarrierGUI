c.lblDbPortV9   = lbl("│", 130, 246, 12, OutlineSkin, 18)
c.lblDbPortV10  = lbl("│", 130, 268, 12, OutlineSkin, 18)
c.lblDbPortV11  = lbl("│", 130, 290, 12, OutlineSkin, 18)
c.lblDbPortV12  = lbl("│", 130, 312, 12, OutlineSkin, 18)
-- Stbd edge (x=410, vertical)
c.lblDbStbdV1   = lbl("│", 410,  70, 12, OutlineSkin, 18)
c.lblDbStbdV2   = lbl("│", 410,  92, 12, OutlineSkin, 18)
